# Copy this file to local.properties.
# NEVER commit it to git — it's already in .gitignore.

# Android SDK path
sdk.dir=C:\\Users\\<user>\\AppData\\Local\\Android\\Sdk

# Google Cloud Console → OAuth 2.0 Client IDs → Android
# Created with your SHA-1 fingerprint + package name.
GOOGLE_CLIENT_ID=your_web_client_id_here.apps.googleusercontent.com

# ExerciseDB API Key (from RapidAPI — optional)
EXERCISEDB_KEY=your_exercisedb_key_here

# Google Drive settings (no need to change)
DRIVE_FOLDER_NAME=DailyHubBackup
DRIVE_SCOPE=https://www.googleapis.com/auth/drive.appdata

# ── Release signing (only needed for release APK/AAB builds) ──
# Keep the release.jks file in the project root; .gitignore already ignores *.jks.
RELEASE_STORE_FILE=release.jks
RELEASE_STORE_PASSWORD=your_keystore_password
RELEASE_KEY_ALIAS=your_key_alias
RELEASE_KEY_PASSWORD=your_key_password
