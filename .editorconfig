# DailyHub — canonical formatting.
# Matches gradle.properties `kotlin.code.style=official` (4-space indent).
# IDEs (Android Studio / IntelliJ) and `editorconfig` plugins pick this up automatically.

root = true

[*]
charset = utf-8
end_of_line = lf
trim_trailing_whitespace = true
insert_final_newline = true

# Kotlin / Gradle scripts
[*.{kt,kts}]
indent_style = space
indent_size = 4
continuation_indent_size = 4
max_line_length = 120
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
ij_kotlin_imports_layout = *,java.**,javax.**,kotlin.**,^

# Android XML (layouts, manifest, resources)
[*.{xml}]
indent_style = space
indent_size = 4
max_line_length = 120

# Gradle properties / config text
[*.{properties,gradle,pro}]
indent_style = space
indent_size = 4
charset = utf-8

# Structured data (keep JSON/YAML 2-space per convention)
[*.{json,yml,yaml}]
indent_style = space
indent_size = 2

# Docs
[*.md]
trim_trailing_whitespace = false
insert_final_newline = true

# SQL
[*.{sql}]
indent_style = space
indent_size = 4
